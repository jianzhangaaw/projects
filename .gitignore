# 依赖与构建产物
node_modules/
target/
dist/
build/
# 注意：不要忽略 out/ —— P3 (Titanic) 与 P4 (Spaceship) 把图与指标放在 out/ 里，
# 那是结果产物不是构建垃圾，README 直接引用它们。曾因为这一行导致两张卡片图在 GitHub 上 404。
*.class
*.jar
*.war

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# IDE
.idea/
*.iml
.vscode/
*.swp

# 数据库数据卷（docker compose 生成）
mysql-data/
*.pid
*.log

# 系统
.DS_Store
Thumbs.db
desktop.ini

# 本地临时产物
_*/
_tools/
_api/
*.tmp

# 站点项目详情页与配图：部署时由 tools/build_site_docs.py 从 README 生成，不进仓库
site/projects/
site/assets/docs/

# 给下一个会话的交接文件，不进仓库
HANDOFF.md

