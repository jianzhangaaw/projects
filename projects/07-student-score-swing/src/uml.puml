@startuml
' 设置样式
skinparam monochrome true
skinparam class {
    BackgroundColor LightBlue
    BorderColor Blue
    ArrowColor DarkBlue
}
skinparam sequence {
    LifeLineBorderColor DarkGreen
    LifeLineBackgroundColor #EEEEEE
}

' 抽象类和接口
abstract class Student {
    -studentId: String
    -name: String
    -className: String
    -chinese: double
    -math: double
    -english: double
    +Student(studentId: String, name: String, className: String, chinese: double, math: double, english: double)
    +abstract getType(): String
    +getTotalScore(): double
    +getStudentId(): String
    +setStudentId(studentId: String): void
    +getName(): String
    +setName(name: String): void
    +getClassName(): String
    +setClassName(className: String): void
    +getChinese(): double
    +setChinese(chinese: double): void
    +getMath(): double
    +setMath(math: double): void
    +getEnglish(): double
    +setEnglish(english: double): void
    +toString(): String
}

' 具体类
class UndergraduateStudent {
    +UndergraduateStudent(studentId: String, name: String, className: String, chinese: double, math: double, english: double)
    +getType(): String
}

class GraduateStudent {
    +GraduateStudent(studentId: String, name: String, className: String, chinese: double, math: double, english: double)
    +getType(): String
}

class StudentManager {
    -students: List<Student>
    -fileHandler: FileHandler
    +StudentManager()
    +loadStudents(): void
    +addStudent(student: Student): boolean
    +getStudentById(studentId: String): Student
    +updateStudent(studentId: String, updatedStudent: Student): boolean
    +deleteStudent(studentId: String): boolean
    +getAllStudents(): List<Student>
    +getStudentsByClass(className: String): List<Student>
    +getStudentsByName(name: String): List<Student>
    +sortBySubject(subject: String): List<Student>
    +sortByTotalScore(): List<Student>
    +sortById(): List<Student>
    +getUndergraduateCount(): int
    +getGraduateCount(): int
    +getTotalCount(): int
}

class FileHandler {
    +saveStudents(students: List<Student>): boolean
    +loadStudents(): List<Student>
}

class LoginHandler {
    -VALID_USERNAME: String
    -VALID_PASSWORD: String
    +authenticate(username: String, password: String): boolean
}

class LoginGUI {
    -usernameField: JTextField
    -passwordField: JPasswordField
    +LoginGUI()
    +main(args: String[]): void
}

class MainGUI {
    -manager: StudentManager
    -outputArea: JTextArea
    +MainGUI()
    +main(args: String[]): void
    +createMenuBar(): void
    +addStudentDialog(): void
    +updateStudentDialog(): void
    +deleteStudentDialog(): void
    +viewAllStudents(): void
    +searchByClassDialog(): void
    +searchByNameDialog(): void
    +searchByIdDialog(): void
    +sortBySubject(subject: String): void
    +sortByTotalScore(): void
    +sortById(): void
    +viewUndergraduateCount(): void
    +viewGraduateCount(): void
    +viewTotalCount(): void
    +showAboutDialog(): void
    +appendText(text: String): void
}

' 继承关系
Student <|-- UndergraduateStudent
Student <|-- GraduateStudent

' 关联关系
StudentManager "1" *-- "1" FileHandler : 使用
MainGUI "1" *-- "1" StudentManager : 使用
LoginGUI "1" ..> "1" LoginHandler : 调用
LoginGUI "1" ..> "1" MainGUI : 登录后创建

' 依赖关系
FileHandler "1" --> "n" Student : 读写
StudentManager "1" --> "n" Student : 管理
@enduml