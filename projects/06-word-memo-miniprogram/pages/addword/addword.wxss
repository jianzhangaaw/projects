page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #F5F7FA 0%, #E4E8EC 100%);
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 24rpx 32rpx;
}

.add-form {
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  margin-bottom: 36rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-label.required::after {
  content: ' *';
  color: #FF5252;
}

.form-input {
  background: #F5F7FA;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.form-input:focus {
  background: #fff;
  border-color: #667eea;
}

.form-btns {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.form-btn {
  flex: 1;
  text-align: center;
  padding: 30rpx;
  border-radius: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.form-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  background: #F5F7FA;
  color: #666;
}

.submit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}