<navigation-bar title="添加单词" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <view class="add-form">
      <view class="form-item required">
        <text class="form-label">单词</text>
        <input class="form-input" bindinput="onNewWordInput" data-field="word" value="{{newWord.word}}" placeholder="请输入单词" />
      </view>
      <view class="form-item">
        <text class="form-label">音标</text>
        <input class="form-input" bindinput="onNewWordInput" data-field="phonetic" value="{{newWord.phonetic}}" placeholder="如: [ə'bændən]" />
      </view>
      <view class="form-item required">
        <text class="form-label">释义</text>
        <input class="form-input" bindinput="onNewWordInput" data-field="meaning" value="{{newWord.meaning}}" placeholder="请输入中文释义" />
      </view>
      <view class="form-item">
        <text class="form-label">例句</text>
        <input class="form-input" bindinput="onNewWordInput" data-field="example" value="{{newWord.example}}" placeholder="请输入英文例句" />
      </view>
      <view class="form-item">
        <text class="form-label">例句翻译</text>
        <input class="form-input" bindinput="onNewWordInput" data-field="exampleCn" value="{{newWord.exampleCn}}" placeholder="请输入例句翻译" />
      </view>

      <view class="form-btns">
        <view class="form-btn cancel-btn" bindtap="onCancelAdd">
          <text>取消</text>
        </view>
        <view class="form-btn submit-btn" bindtap="onAddWord">
          <text>添加</text>
        </view>
      </view>
    </view>
  </view>
</scroll-view>