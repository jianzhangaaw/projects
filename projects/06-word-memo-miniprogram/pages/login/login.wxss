page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  overflow: hidden;
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 40rpx 32rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}
.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}
.deco-circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -100rpx;
  right: -100rpx;
  animation: float 8s ease-in-out infinite;
}
.deco-circle-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: 200rpx;
  left: -50rpx;
  animation: float 6s ease-in-out infinite reverse;
}
.deco-circle-3 {
  width: 150rpx;
  height: 150rpx;
  top: 40%;
  right: 20%;
  animation: float 10s ease-in-out infinite;
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-30rpx); }
}

/* 登录头部 */
.login-header {
  text-align: center;
  padding: 80rpx 0 60rpx;
}
.logo-wrap {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}
.logo-icon {
  font-size: 64rpx;
}
.app-name {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 16rpx;
}
.app-slogan {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

/* 登录内容卡片 */
.login-content {
  background: #fff;
  border-radius: 36rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 40rpx;
}

/* 头像区域 */
.avatar-section {
  text-align: center;
  margin-bottom: 50rpx;
}
.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 auto;
  position: relative;
  background: linear-gradient(135deg, #F5F7FA 0%, #E4E8EC 100%);
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
}
.avatar-btn::after {
  border: none;
}
.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}
.avatar-placeholder {
  font-size: 64rpx;
}
.avatar-hint {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 20rpx;
  padding: 10rpx 0;
  text-align: center;
}

/* 输入区域 */
.input-section {
  margin-bottom: 48rpx;
}
.input-item {
  margin-bottom: 32rpx;
}
.input-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
  font-weight: 500;
}
.input-field {
  background: #F5F7FA;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 32rpx;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}
.input-field:focus {
  background: #fff;
  border-color: #667eea;
}

/* 按钮区域 */
.btn-section {
  margin-bottom: 32rpx;
}
.login-btn {
  width: 100%;
  padding: 32rpx;
  border-radius: 56rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  border: none;
  position: relative;
  overflow: hidden;
}
.login-btn::after {
  border: none;
}
.wechat-btn {
  background: linear-gradient(135deg, #07c160 0%, #06ae56 100%);
  color: #fff;
}
.phone-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}
.login-btn[disabled] {
  opacity: 0.6;
}
.btn-icon {
  font-size: 36rpx;
}
.btn-glow {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  animation: shimmer 2s infinite;
}
@keyframes shimmer {
  0% { left: -100%; }
  100% { left: 100%; }
}

/* 跳过区域 */
.skip-section {
  text-align: center;
  margin-top: 24rpx;
}
.skip-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部信息 */
.login-footer {
  text-align: center;
  padding: 40rpx 0;
}
.footer-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}