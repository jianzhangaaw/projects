/**pages/profile/profile.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #F5F7FA 0%, #E4E8EC 100%);
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 24rpx 32rpx;
}

/* 用户信息 */
.user-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  padding: 48rpx;
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}
.user-bg {
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}
.user-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.15);
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
}
.user-avatar-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
}
.user-detail {
  flex: 1;
}
.user-nickname {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 10rpx;
}
.user-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}
.user-stats {
  display: flex;
  justify-content: space-around;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
}
.stat-item {
  text-align: center;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}
.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}
.stat-divider {
  width: 2rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.2);
}

/* 操作按钮 */
.action-section {
  margin-bottom: 32rpx;
}
.login-btn, .logout-btn {
  background: #fff;
  border-radius: 56rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #667eea;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}
.login-btn:active, .logout-btn:active {
  transform: scale(0.98);
}
.logout-btn {
  color: #FF5252;
}

/* 区块 */
.section {
  margin-bottom: 32rpx;
}
.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding-left: 8rpx;
}
.section-icon {
  font-size: 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

/* 设置卡片 */
.setting-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
}
.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F5F5F5;
  transition: background 0.2s ease;
}
.setting-item:active {
  background: #FAFAFA;
}
.setting-item:last-child {
  border-bottom: none;
}
.setting-item.danger .setting-label {
  color: #FF5252;
}
.setting-info {
  flex: 1;
}
.setting-label {
  font-size: 32rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.setting-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
}
.goal-input-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.goal-input {
  width: 120rpx;
  text-align: center;
  background: #F5F7FA;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.goal-unit {
  font-size: 26rpx;
  color: #999;
}
.arrow {
  font-size: 40rpx;
  color: #ccc;
}
.danger-arrow {
  font-size: 32rpx;
}

/* 模式卡片 */
.mode-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
}
.mode-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #F5F5F5;
  transition: all 0.2s ease;
}
.mode-item:active {
  background: #FAFAFA;
}
.mode-item:last-child {
  border-bottom: none;
}
.mode-item.active {
  background: #F0F4FF;
}
.mode-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.mode-icon {
  font-size: 36rpx;
}
.mode-label {
  font-size: 32rpx;
  color: #333;
}
.mode-check {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}
.mode-check text {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

/* 底部留白 */
.bottom-space {
  height: 140rpx;
}