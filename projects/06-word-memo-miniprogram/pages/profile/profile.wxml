<!--pages/profile/profile.wxml-->
<navigation-bar title="我的" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 用户信息 -->
    <view class="user-section">
      <view class="user-bg"></view>
      <view class="user-info">
        <view class="user-avatar-wrap">
          <image wx:if="{{user.avatar}}" class="user-avatar" src="{{user.avatar}}" mode="aspectFill"></image>
          <text wx:else class="user-avatar-text">{{user.nickname ? user.nickname.charAt(0) : '?'}}</text>
        </view>
        <view class="user-detail">
          <text class="user-nickname">{{user.nickname || '未登录'}}</text>
          <text class="user-desc">已坚持学习 {{user.studyDays || 0}} 天</text>
        </view>
      </view>
      <view class="user-stats">
        <view class="stat-item">
          <text class="stat-value">{{user.totalWords || 0}}</text>
          <text class="stat-label">已学单词</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{user.studyDays || 0}}</text>
          <text class="stat-label">学习天数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{user.masteredWords || 0}}</text>
          <text class="stat-label">已掌握</text>
        </view>
      </view>
    </view>

    <!-- 登录/退出按钮 -->
    <view class="action-section" wx:if="{{!isLoggedIn}}">
      <view class="login-btn" bindtap="goLogin">
        <text>立即登录</text>
      </view>
    </view>
    <view class="action-section" wx:if="{{isLoggedIn}}">
      <view class="logout-btn" bindtap="onLogout">
        <text>退出登录</text>
      </view>
    </view>

    <!-- 学习设置 -->
    <view class="section">
      <view class="section-header">
        <text class="section-icon">⚙️</text>
        <text class="section-title">学习设置</text>
      </view>
      <view class="setting-card">
        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-label">每日目标</text>
            <text class="setting-desc">每天学习的新词数量</text>
          </view>
          <view class="goal-input-wrap">
            <input type="number" class="goal-input" value="{{settings.dailyGoal}}" bindblur="onDailyGoalChange" />
            <text class="goal-unit">词/天</text>
          </view>
        </view>

        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-label">自动播放发音</text>
            <text class="setting-desc">显示单词时自动播放发音</text>
          </view>
          <switch checked="{{settings.autoPlay}}" data-field="autoPlay" bindchange="onSwitchChange" color="#667eea" />
        </view>

        <view class="setting-item">
          <view class="setting-info">
            <text class="setting-label">显示音标</text>
            <text class="setting-desc">在学习时显示单词音标</text>
          </view>
          <switch checked="{{settings.showPhonetic}}" data-field="showPhonetic" bindchange="onSwitchChange" color="#667eea" />
        </view>
      </view>
    </view>

    <!-- 学习模式 -->
    <view class="section">
      <view class="section-header">
        <text class="section-icon">📚</text>
        <text class="section-title">学习模式</text>
      </view>
      <view class="mode-card">
        <view class="mode-item {{settings.studyMode === item.value ? 'active' : ''}}"
              wx:for="{{studyModes}}"
              wx:key="value"
              bindtap="onModeChange"
              data-mode="{{item.value}}">
          <view class="mode-left">
            <text class="mode-icon">{{item.icon}}</text>
            <text class="mode-label">{{item.label}}</text>
          </view>
          <view class="mode-check" wx:if="{{settings.studyMode === item.value}}">
            <text>✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 数据管理 -->
    <view class="section">
      <view class="section-header">
        <text class="section-icon">💾</text>
        <text class="section-title">数据管理</text>
      </view>
      <view class="setting-card">
        <view class="setting-item danger" bindtap="onResetData">
          <view class="setting-info">
            <text class="setting-label">重置学习数据</text>
            <text class="setting-desc">清空所有进度，重新开始</text>
          </view>
          <text class="danger-arrow">⚠</text>
        </view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="section">
      <view class="section-header">
        <text class="section-icon">ℹ️</text>
        <text class="section-title">关于</text>
      </view>
      <view class="setting-card">
        <view class="setting-item" bindtap="onAbout">
          <view class="setting-info">
            <text class="setting-label">关于小程序</text>
            <text class="setting-desc">单词背诵助手 v1.0</text>
          </view>
          <text class="arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </view>
</scroll-view>

<!-- 自定义TabBar -->
<tab-bar selected="4"></tab-bar>