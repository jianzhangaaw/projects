<!--pages/review/review.wxml-->
<navigation-bar title="复习" back="{{true}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 进度条 -->
    <view class="progress-section" wx:if="{{reviewWords.length > 0}}">
      <view class="progress-header">
        <text class="progress-text">复习进度</text>
        <text class="progress-count">{{currentIndex + 1}} / {{reviewWords.length}}</text>
      </view>
      <view class="progress-bar-bg">
        <view class="progress-bar-fill" style="width: {{progressPercent}}%"></view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="review-empty" wx:if="{{reviewWords.length === 0}}">
      <view class="empty-icon-wrap">
        <text class="empty-icon">🎉</text>
      </view>
      <text class="empty-text">太棒了！</text>
      <text class="empty-desc">目前没有需要复习的单词</text>
      <view class="back-home-btn" bindtap="goBack">
        <text>返回首页</text>
      </view>
    </view>

    <!-- 复习卡片 -->
    <view class="review-card" wx:if="{{currentWord && reviewWords.length > 0}}">
      <view class="card-content" wx:if="{{!showAnswer}}">
        <view class="card-header">
          <text class="card-label">回忆单词含义</text>
        </view>
        <view class="card-word">
          <text class="word">{{currentWord.word}}</text>
          <text class="phonetic">{{currentWord.phonetic}}</text>
        </view>
        <view class="play-audio" bindtap="playAudio">
          <text class="play-icon">🔊</text>
          <text class="play-text">播放发音</text>
        </view>
        <view class="card-hint">
          <text>点击下方按钮查看答案</text>
        </view>
      </view>

      <view class="card-content answer-card" wx:if="{{showAnswer}}">
        <view class="card-header">
          <text class="card-label">单词释义</text>
        </view>
        <view class="card-word">
          <text class="word">{{currentWord.word}}</text>
          <text class="phonetic">{{currentWord.phonetic}}</text>
        </view>
        <view class="card-meaning">
          <text class="meaning">{{currentWord.meaning}}</text>
        </view>
        <view class="example-section">
          <text class="example-label">例句</text>
          <text class="example-en">{{currentWord.example}}</text>
          <text class="example-cn">{{currentWord.exampleCn}}</text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-btns" wx:if="{{currentWord}}">
      <block wx:if="{{!showAnswer}}">
        <view class="action-btn show-answer-btn" bindtap="onShowAnswer">
          <text>显示答案</text>
        </view>
      </block>
      <block wx:else>
        <view class="action-btn forget-btn" bindtap="onForget">
          <text>😭 忘了</text>
        </view>
        <view class="action-btn remember-btn" bindtap="onRemember">
          <text>✓ 记住了</text>
        </view>
      </block>
    </view>

    <!-- 返回按钮 -->
    <view class="back-btn" bindtap="goBack" wx:if="{{reviewWords.length > 0}}">
      <text>退出复习</text>
    </view>
  </view>
</scroll-view>