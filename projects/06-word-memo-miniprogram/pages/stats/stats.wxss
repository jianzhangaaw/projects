/**pages/stats/stats.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #F5F7FA 0%, #E4E8EC 100%);
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 24rpx 32rpx;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 32rpx;
  display: block;
}

/* 今日概况 */
.today-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.today-card .card-title {
  color: #fff;
  margin-bottom: 0;
}
.card-date {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}
.today-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.today-card .stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-icon-wrap {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}
.today-card .stat-value {
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
}
.today-card .stat-label {
  color: rgba(255, 255, 255, 0.8);
}
.stat-divider {
  width: 2rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 统计项通用 */
.stat-item {
  text-align: center;
}
.stat-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #333;
  display: block;
}
.stat-label {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 总览 */
.overview-stats {
  display: flex;
  justify-content: space-around;
}
.overview-card .stat-value {
  color: #667eea;
  font-size: 44rpx;
}

/* 图表卡片 */
.chart-card {
  padding-bottom: 20rpx;
}
.week-chart {
  padding: 0 10rpx;
}
.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 220rpx;
}
.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.bar-wrap {
  width: 44rpx;
  height: 160rpx;
  background: #F0F0F0;
  border-radius: 22rpx;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.bar {
  width: 100%;
  background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  border-radius: 22rpx;
  min-height: 4rpx;
  transition: height 0.3s ease;
}
.bar-today {
  background: linear-gradient(180deg, #4CAF50 0%, #67B26F 100%);
}
.bar-value {
  font-size: 24rpx;
  color: #333;
  margin: 12rpx 0 6rpx;
  font-weight: 500;
}
.bar-label {
  font-size: 22rpx;
  color: #999;
}
.label-today {
  color: #4CAF50;
  font-weight: 600;
}

/* 分布卡片 */
.distribution-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}
.dist-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dist-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.dist-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
}
.dist-name {
  font-size: 30rpx;
  color: #333;
}
.dist-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.dist-value {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}
.dist-progress-bg {
  width: 200rpx;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}
.dist-progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 成就卡片 */
.achievement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}
.achievement-item {
  background: #F8F9FA;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  opacity: 0.5;
  filter: grayscale(1);
}
.achievement-item.achieved {
  background: #fff;
  opacity: 1;
  filter: grayscale(0);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.achievement-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}
.achievement-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}
.achievement-desc {
  font-size: 22rpx;
  color: #999;
  display: block;
}

/* 底部留白 */
.bottom-space {
  height: 140rpx;
}