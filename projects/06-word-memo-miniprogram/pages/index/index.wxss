/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #F5F7FA 0%, #E4E8EC 100%);
}
.scrollarea {
  flex: 1;
  overflow-y: hidden;
}

.container {
  padding: 24rpx 32rpx;
}

/* 欢迎区域 */
.greeting-section {
  padding: 32rpx 0 40rpx;
}
.greeting-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.greeting {
  font-size: 52rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: 2rpx;
}
.greeting-icon {
  font-size: 48rpx;
  animation: bounce 2s infinite;
}
@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}
.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-top: 16rpx;
  display: block;
  letter-spacing: 1rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
}
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}
.card-badge {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.25);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 进度卡片 */
.progress-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  overflow: hidden;
}
.progress-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}
.progress-card::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: -10%;
  width: 150rpx;
  height: 150rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}
.progress-card .card-title {
  color: #fff;
  position: relative;
  z-index: 1;
}
.progress-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  z-index: 1;
}
.progress-bar {
  flex: 1;
  height: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 10rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #fff;
  border-radius: 10rpx;
  transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}
.progress-percent {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  min-width: 80rpx;
  text-align: right;
}
.progress-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  position: relative;
  z-index: 1;
}
.stat-item {
  text-align: center;
  flex: 1;
}
.stat-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}
.stat-icon-wrap.blue {
  background: rgba(74, 144, 217, 0.2);
}
.stat-icon-wrap.orange {
  background: rgba(255, 165, 0, 0.2);
}
.stat-icon-wrap.green {
  background: rgba(103, 178, 111, 0.2);
}
.stat-icon {
  font-size: 28rpx;
}
.stat-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
}
.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  display: block;
}
.stat-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.2);
  margin: 16rpx 0;
}

/* 章节标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

/* 操作卡片 */
.action-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 40rpx;
}
.action-card {
  flex: 1;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.2s ease;
}
.action-card:active {
  transform: scale(0.98);
}
.action-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}
.action-icon-wrap.new {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E53 100%);
}
.action-icon-wrap.review {
  background: linear-gradient(135deg, #4A90D9 0%, #35C772 100%);
}
.action-icon {
  font-size: 44rpx;
  color: #fff;
}
.action-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.action-desc {
  font-size: 24rpx;
  color: #999;
  display: block;
}

/* 开始学习按钮 */
.start-section {
  text-align: center;
  margin-bottom: 40rpx;
}
.start-btn {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 56rpx;
  padding: 32rpx 64rpx;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.4);
  transition: transform 0.2s ease;
}
.start-btn:active {
  transform: scale(0.98);
}
.start-btn-icon {
  font-size: 40rpx;
}
.start-btn-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}
.start-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
  display: block;
}

/* 统计卡片 */
.stats-card {
  background: linear-gradient(135deg, #FFFAF0 0%, #FFF8E7 100%);
  border: 2rpx solid #FFE4B5;
}
.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.stats-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.stats-subtitle {
  font-size: 24rpx;
  color: #8B7355;
}
.stats-content {
  display: flex;
  align-items: baseline;
}
.stats-value {
  font-size: 80rpx;
  font-weight: 900;
  color: #CD853F;
  line-height: 1;
}
.stats-unit {
  font-size: 32rpx;
  color: #8B7355;
  margin-left: 8rpx;
}

/* 底部留白 */
.bottom-space {
  height: 140rpx;
}