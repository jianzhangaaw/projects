<!--pages/wordlist/wordlist.wxml-->
<navigation-bar title="词库" back="{{false}}" color="black" background="#FFF"></navigation-bar>
<scroll-view class="scrollarea" scroll-y type="list">
  <view class="container">
    <!-- 搜索框 -->
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索单词或释义" bindinput="onSearch" value="{{searchKeyword}}" />
      <view class="clear-btn" wx:if="{{searchKeyword}}" bindtap="onClearSearch">
        <text>×</text>
      </view>
    </view>

    <!-- 筛选标签 -->
    <view class="filter-tabs">
      <view class="filter-tab {{filterType === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-type="all">
        <text>全部</text>
        <text class="tab-count">{{allCount}}</text>
      </view>
      <view class="filter-tab {{filterType === 'new' ? 'active' : ''}}" bindtap="onFilterChange" data-type="new">
        <text>新词</text>
        <text class="tab-count">{{newCount}}</text>
      </view>
      <view class="filter-tab {{filterType === 'learning' ? 'active' : ''}}" bindtap="onFilterChange" data-type="learning">
        <text>学习中</text>
        <text class="tab-count">{{learningCount}}</text>
      </view>
      <view class="filter-tab {{filterType === 'mastered' ? 'active' : ''}}" bindtap="onFilterChange" data-type="mastered">
        <text>已掌握</text>
        <text class="tab-count">{{masteredCount}}</text>
      </view>
    </view>

    <!-- 筛选结果数量 -->
    <view class="filter-result" wx:if="{{searchKeyword || filterType !== 'all'}}">
      <text>找到 {{words.length}} 个单词</text>
    </view>

    <!-- 单词列表 -->
    <view class="word-list">
      <block wx:for="{{words}}" wx:key="id">
        <view class="word-item {{item.expanded ? 'expanded' : ''}}" bindtap="onWordTap" data-word="{{item}}" data-expanded="{{item.expanded || false}}">
          <view class="word-header">
            <view class="word-main">
              <text class="word-text">{{item.word}}</text>
              <text class="word-phonetic">{{item.phonetic}}</text>
            </view>
            <view class="word-status {{getStatusClass(item.status)}}">
              {{getStatusText(item.status)}}
            </view>
          </view>
          <text class="word-meaning">{{item.meaning}}</text>
          <view class="word-detail" wx:if="{{item.expanded}}">
            <view class="example-section">
              <text class="example-label">例句</text>
              <text class="example-en">{{item.example}}</text>
              <text class="example-cn">{{item.exampleCn}}</text>
            </view>
            <view class="word-actions">
              <text class="delete-btn" catchtap="onDeleteWord" data-id="{{item.id}}">删除单词</text>
            </view>
          </view>
        </view>
      </block>

      <view class="empty-tip" wx:if="{{words.length === 0}}">
        <text class="empty-icon">📚</text>
        <text class="empty-text">暂无匹配的单词</text>
      </view>
    </view>

    <!-- 添加单词按钮 -->
    <view class="add-btn" bindtap="onAddWord">
      <text class="add-icon">+</text>
      <text class="add-btn-text">添加单词</text>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </view>
</scroll-view>

<!-- 自定义TabBar -->
<tab-bar selected="1"></tab-bar>