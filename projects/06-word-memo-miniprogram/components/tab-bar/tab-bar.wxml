<!--components/tab-bar/tab-bar.wxml-->
<view class="tab-bar">
  <view class="tab-item {{selected === index ? 'active' : ''}}"
        wx:for="{{tabList}}"
        wx:key="index"
        bindtap="onTabTap"
        data-index="{{index}}">
    <text class="tab-icon">{{item.icon === 'home' ? '🏠' : item.icon === 'book' ? '📖' : item.icon === 'study' ? '📚' : item.icon === 'chart' ? '📊' : '👤'}}</text>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>